{
  "name": "offisea",
  "productName": "Offisea",
  "version": "1.0.2",
  "description": "Ücretsiz, çevrimdışı çalışan ofis uygulaması: belge, tablo, sunum ve PDF.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Offisea",
  "license": "MIT",
  "scripts": {
    "assets": "node scripts/copy-pdfjs.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "build:electron": "npm run build",
    "build:android": "npm run build",
    "electron": "npm run build:electron && electron .",
    "dist:win": "npm run build:electron && electron-builder --win --publish never",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew assembleRelease",
    "audit": "npm audit",
    "sign": "node scripts/sign-update.mjs",
    "update-key": "node scripts/update-keygen.mjs",
    "release:web": "npm run build && npm run sign"
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "docx": "^9.14.0",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "electron": true,
    "sharp": true,
    "electron-winstaller": true
  },
  "build": {
    "appId": "app.offisea.office",
    "productName": "Offisea",
    "copyright": "Offisea",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!dist/testfiles/**",
      "!dist/update.json",
      "!dist/_headers"
    ],
    "asar": true,
    "electronLanguages": [
      "tr",
      "en-US"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "Offisea"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Offisea",
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "language": "1055",
      "artifactName": "Offisea-${version}-Kurulum-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Offisea-${version}-Tasinabilir.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "docx",
          "docm",
          "dotx",
          "odt",
          "rtf"
        ],
        "name": "OffiseaBelge",
        "description": "Belge",
        "role": "Editor"
      },
      {
        "ext": [
          "xlsx",
          "xlsm",
          "xls",
          "ods",
          "csv"
        ],
        "name": "OffiseaTablo",
        "description": "Tablo",
        "role": "Editor"
      },
      {
        "ext": [
          "pptx",
          "ppsx",
          "potx"
        ],
        "name": "OffiseaSunu",
        "description": "Sunu",
        "role": "Editor"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "OffiseaPDF",
        "description": "PDF belgesi",
        "role": "Viewer"
      }
    ]
  }
}
